<Window x:Class="HwMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HwMonitor"
        Title="HW Monitor"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

  <Window.Resources>
    <!-- Ombre noire sous les textes : lisibilite par-dessus un jeu clair ou sombre -->
    <DropShadowEffect x:Key="TxtShadow" Color="#000000" ShadowDepth="1" BlurRadius="5" Opacity="0.9" Direction="315" />

    <!-- Boutons fantomes (reglage + croix) : INVISIBLES en temps normal, ils
         n'apparaissent que quand la souris survole l'overlay. -->
    <Style x:Key="GhostBtnStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#B9B9C6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{x:Static local:MainWindow.PtGhost}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Effect" Value="{StaticResource TxtShadow}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="5" Background="#22000000" Width="20" Height="20">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#55FFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Option du menu de disposition -->
    <Style x:Key="MenuOptStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#DDDDE6" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="{x:Static local:MainWindow.PtMenu}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="5" Background="Transparent" Padding="10,6">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Fond quasi transparent mais cliquable (#01...) : toute la surface de
       l'overlay detecte le survol (croix + reglage) et sert de poignee pour
       deplacer, sans rien afficher de plus. -->
  <Grid Margin="12,8,12,10" MinWidth="120" Background="#01000000">
    <!-- Discretion : l'overlay s'efface par-dessus le jeu, et redevient pleinement
         lisible des que la souris passe dessus (comme les boutons fantomes). -->
    <Grid.Style>
      <Style TargetType="Grid">
        <Setter Property="Opacity" Value="{x:Static local:MainWindow.OpacityRest}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Opacity" Value="1" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Boutons au survol : reglage de disposition + fermeture -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="GearBtn" Content="⚙" Click="GearBtn_Click"
              Style="{StaticResource GhostBtnStyle}" Margin="0,0,4,0"
              ToolTip="Disposition de l'overlay" />
      <Button x:Name="CloseBtn" Content="✕" Click="CloseBtn_Click"
              Style="{StaticResource GhostBtnStyle}" ToolTip="Fermer l'overlay" />
    </StackPanel>

    <!-- Menu de disposition (s'ouvre au clic sur ⚙) -->
    <Popup x:Name="LayoutPopup" PlacementTarget="{Binding ElementName=GearBtn}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-70" VerticalOffset="2">
      <Border Background="#F2141420" BorderBrush="#40FFFFFF" BorderThickness="1"
              CornerRadius="8" Padding="5">
        <StackPanel MinWidth="130">
          <TextBlock Text="DISPOSITION" FontFamily="Segoe UI Variable Display, Segoe UI"
                     FontSize="{x:Static local:MainWindow.PtMenuTitle}" FontWeight="Bold" Foreground="#7A7A88" Margin="10,3,0,4" />
          <Button x:Name="OptLigne" Tag="ligne" Click="LayoutOption_Click" Style="{StaticResource MenuOptStyle}" />
          <Button x:Name="OptColonne" Tag="colonne" Click="LayoutOption_Click" Style="{StaticResource MenuOptStyle}" />
          <Button x:Name="OptMixte" Tag="mixte" Click="LayoutOption_Click" Style="{StaticResource MenuOptStyle}" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- Corps : construit par le code selon la disposition (ligne / colonne / mixte) -->
    <StackPanel x:Name="Body" Grid.Row="1" Margin="0,2,0,0" />
  </Grid>
</Window>
